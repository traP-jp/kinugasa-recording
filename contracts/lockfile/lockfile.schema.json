{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/traP-jp/kinugasa-recording/v2/contracts/lockfile/lockfile.schema.json",
  "title": "kinugasa-recording pipeline input lock file",
  "type": "object",
  "required": [
    "schemaVersion",
    "bucket",
    "objects"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "bucket": {
      "type": "string",
      "minLength": 1
    },
    "objects": {
      "type": "object",
      "propertyNames": {
        "pattern": "^recording/[A-Za-z0-9](?:[A-Za-z0-9_-]*[A-Za-z0-9])?/[A-Za-z0-9](?:[A-Za-z0-9_-]*[A-Za-z0-9])?/[A-Za-z0-9](?:[A-Za-z0-9_-]*[A-Za-z0-9])?/video\\.mp4$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/object"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "object": {
      "type": "object",
      "required": [
        "key",
        "sha256",
        "size"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^recording/[A-Za-z0-9](?:[A-Za-z0-9_-]*[A-Za-z0-9])?/[A-Za-z0-9](?:[A-Za-z0-9_-]*[A-Za-z0-9])?/[A-Za-z0-9](?:[A-Za-z0-9_-]*[A-Za-z0-9])?/[0-9a-f]{64}-video\\.mp4$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
